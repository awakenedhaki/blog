# Security headers for static hosts that read this file (Netlify, Cloudflare
# Pages). GitHub Pages, where this site is hosted, does NOT read it; see
# docs/github-pages.md for what that means.
#
# A prerendered site has no server-side attack surface: no request handling, no
# database, no user input. What remains is what the BROWSER can be talked into
# doing with the files, which is what these headers constrain.
/*
  # The real backstop for the inlined-SVG path in Figure.svelte. The sanitiser
  # there is a denylist; this is the thing that holds if the denylist misses a
  # vector. 'unsafe-inline' for style-src is required because Svelte emits
  # scoped styles and the theme bootstrap sets CSS variables inline.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  # Stop the browser guessing a content type it was not given.
  X-Content-Type-Options: nosniff
  # No clickjacking wrapper; duplicates frame-ancestors for older browsers.
  X-Frame-Options: DENY
  # Send the origin, not the full path, to third parties.
  Referrer-Policy: strict-origin-when-cross-origin
  # This site asks for none of these.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Hashed asset filenames are immutable by construction, so they can be cached
# forever. HTML must not be, or a deploy would not reach returning readers.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/search-index.json
  Cache-Control: public, max-age=3600
